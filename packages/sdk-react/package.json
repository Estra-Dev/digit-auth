{
  "name": "@digit-auth/react",
  "version": "0.1.2",
  "private": false,
  "description": "React SDK for building applications with DigitAuth authentication and authorization.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/Estra-Dev/digit-auth.git",
    "directory": "packages/sdk-react"
  },
  "bugs": {
    "url": "https://github.com/Estra-Dev/digit-auth/issues"
  },
  "homepage": "https://github.com/Estra-Dev/digit-auth#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "pack:check": "pnpm build && pnpm pack --dry-run",
    "test": "vitest run"
  },
  "keywords": [
    "authentication",
    "authorization",
    "auth",
    "react",
    "sdk",
    "typescript",
    "digit-auth"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.0",
    "jsdom": "^30.1.2",
    "react": "^19.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
